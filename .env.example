# Supabase project URL (Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key, safe to ship to the browser (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Server-only secret / service-role key. Never expose to the browser.
SUPABASE_SECRET_KEY=eyJhbGciOi...

# OpenAI key. Single-user, env-driven. Every server-side OpenAI call reads
# this. From platform.openai.com/api-keys.
OPENAI_API_KEY=sk-...

# Optional. Required only if you wire up the /api/cron/poll-sources route
# (Vercel Cron, GitHub Actions, etc.). Any random string the caller passes as
# `Authorization: Bearer <secret>`.
# CRON_SECRET=
