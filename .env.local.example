# Supabase project URL (Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key, safe to ship to the browser (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Server-only secret / service-role key. Never expose to the browser.
SUPABASE_SECRET_KEY=eyJhbGciOi...

# Master key used to AES-256-GCM encrypt user-supplied provider keys at rest.
# Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
BYOK_ENCRYPTION_KEY=base64-32-bytes-here

# Optional. Required only if you wire up the /api/cron/starter-prompts route
# (Vercel Cron, GitHub Actions, etc.). Any random string the caller passes as
# `Authorization: Bearer <secret>`.
# CRON_SECRET=

# Optional. Only used by scripts/seed-byok-key.mjs to seed your own encrypted
# Anthropic key for local testing. Not read by the running app.
# ANTHROPIC_API_KEY=
